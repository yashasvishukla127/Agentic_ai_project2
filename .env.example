# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=p2_rag
POSTGRES_USER=p2_user
POSTGRES_PASSWORD=root

# PgBouncer Configuration (optional)
PGBOUNCER_PORT=6432
PGBOUNCER_USER=p2_user
PGBOUNCER_PASSWORD=root

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
